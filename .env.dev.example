## Local development. Copy to .env.dev and fill the two keys:
##   UNI_ENCRYPTION_KEY: openssl rand -hex 16
##   UNI_JWT_SECRET:     openssl rand -hex 32
## Runs with no Docker: embedded PostgreSQL (PGlite) and in-process Redis.
## PGlite only supports UNI_EDITION=ce; use a real Postgres for ee/cloud.

UNI_ENVIRONMENT=dev
UNI_EDITION=ce
UNI_FRONTEND_URL=http://localhost:4200
UNI_EXECUTION_MODE=UNSANDBOXED
UNI_LOG_LEVEL=info
UNI_LOG_PRETTY=true
UNI_TELEMETRY_ENABLED=false

UNI_ENCRYPTION_KEY=
UNI_JWT_SECRET=

UNI_DB_TYPE=PGLITE
UNI_REDIS_TYPE=MEMORY

## Comma-separated piece folder names to build and hot-reload locally, e.g. slack,gmail
# UNI_DEV_PIECES=

## Set automatically by `npm start` (tools/setup-dev.js)
# UNI_DENO_PATH=
