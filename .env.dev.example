## Local development. Copy to .env.dev and fill the two keys:
##   AP_ENCRYPTION_KEY: openssl rand -hex 16
##   AP_JWT_SECRET:     openssl rand -hex 32
## Runs with no Docker: embedded PostgreSQL (PGlite) and in-process Redis.
## PGlite only supports AP_EDITION=ce; use a real Postgres for ee/cloud.

AP_ENVIRONMENT=dev
AP_EDITION=ce
AP_FRONTEND_URL=http://localhost:4200
AP_EXECUTION_MODE=UNSANDBOXED
AP_LOG_LEVEL=info
AP_LOG_PRETTY=true
AP_TELEMETRY_ENABLED=false

AP_ENCRYPTION_KEY=
AP_JWT_SECRET=

AP_DB_TYPE=PGLITE
AP_REDIS_TYPE=MEMORY

## Comma-separated piece folder names to build and hot-reload locally, e.g. slack,gmail
# AP_DEV_PIECES=

## Set automatically by `npm start` (tools/setup-dev.js)
# AP_DENO_PATH=
