## Self-hosted configuration. Run `sh tools/deploy.sh` to copy this to .env and generate the secrets.
## Full reference: docs/install/reference/environment-variables.mdx

AP_ENVIRONMENT=prod
AP_FRONTEND_URL=http://localhost:8080
AP_EXECUTION_MODE=UNSANDBOXED
AP_TELEMETRY_ENABLED=true
AP_WEBHOOK_TIMEOUT_SECONDS=30

## Generated by tools/deploy.sh
AP_API_KEY=
AP_ENCRYPTION_KEY=
AP_JWT_SECRET=

AP_DB_TYPE=POSTGRES
AP_POSTGRES_HOST=postgres
AP_POSTGRES_PORT=5432
AP_POSTGRES_DATABASE=united
AP_POSTGRES_USERNAME=postgres
AP_POSTGRES_PASSWORD=

AP_REDIS_TYPE=STANDALONE
AP_REDIS_HOST=redis
AP_REDIS_PORT=6379
