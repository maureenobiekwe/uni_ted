## Self-hosted configuration. Run `sh tools/deploy.sh` to copy this to .env and generate the secrets.
## Full reference: docs/install/reference/environment-variables.mdx

UNI_ENVIRONMENT=prod
UNI_FRONTEND_URL=http://localhost:8080
UNI_EXECUTION_MODE=UNSANDBOXED
UNI_TELEMETRY_ENABLED=true
UNI_WEBHOOK_TIMEOUT_SECONDS=30

## Generated by tools/deploy.sh
UNI_API_KEY=
UNI_ENCRYPTION_KEY=
UNI_JWT_SECRET=

UNI_DB_TYPE=POSTGRES
UNI_POSTGRES_HOST=postgres
UNI_POSTGRES_PORT=5432
UNI_POSTGRES_DATABASE=united
UNI_POSTGRES_USERNAME=postgres
UNI_POSTGRES_PASSWORD=

UNI_REDIS_TYPE=STANDALONE
UNI_REDIS_HOST=redis
UNI_REDIS_PORT=6379
